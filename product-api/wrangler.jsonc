{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "product-api",
	"main": "src/index.js",
	"compatibility_date": "2025-11-11",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "products_db",
			"database_name": "products_db",
			"database_id": "49a92463-b938-41aa-ad5b-78cee1bc9d75"
		},
		
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "2ca0be84e7564551bc6973ea6bd6ca19",
			
		}
	],
	"triggers": {
		"crons": [
			"0 0 1 * *"
		]
	}
}